# Google Docs source document
GOOGLE_DOC_ID=your_google_doc_id_here
# Path to a service-account JSON key file, OR the raw JSON itself
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# How long Google Doc content is cached (seconds)
DOCS_CACHE_TTL_SECONDS=900

# Absolute base URL for chat source links (falls back to request host when empty)
SITE_BASE_URL=

# Per-IP rate limit for the chat API
CHAT_RATE_LIMIT=20 per minute

# Flask configuration
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-in-production
FLASK_DEBUG=1

# Vite dev server URL (used by Flask templates in development)
VITE_DEV_SERVER=http://localhost:5173
